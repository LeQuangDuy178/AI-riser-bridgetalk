# BridgeTalk backend configuration.
# Copy to .env.local (gitignored) and fill in for production. In DEMO_MODE, the
# backend skips Firebase auth, skips Cloud TTS, and keeps transcripts in memory
# so the local walk-through runs without any cloud credentials.

PORT=8787

# Production: real Firebase ID-token verification. Provide either
# FIREBASE_SERVICE_ACCOUNT (path to a service account JSON) or set
# GOOGLE_APPLICATION_CREDENTIALS. When unset, the backend reports
# FIREBASE_AUTH_NOT_CONFIGURED on /send unless DEMO_MODE=true.
# FIREBASE_SERVICE_ACCOUNT=

# Production: real Google Cloud Text-to-Speech. Set
# GOOGLE_APPLICATION_CREDENTIALS to a service account with the
# Cloud Text-to-Speech User role. When unset, /send returns
# TTS_NOT_CONFIGURED unless DEMO_MODE=true.
# GOOGLE_APPLICATION_CREDENTIALS=

# Production: Firestore for consent-gated transcript persistence. Set
# GOOGLE_APPLICATION_CREDENTIALS and FIRESTORE_PROJECT_ID. When unset,
# transcripts stay in memory and are lost on restart.
# FIRESTORE_PROJECT_ID=

# Backend Gemini API key for the /api/suggestions endpoint. NEVER expose this
# to the Android client; the Android app calls the backend over HTTPS and the
# backend adds the key server-side. If unset, /api/suggestions returns 503.
GEMINI_API_KEY=

# TTS voice used by Cloud TTS (production) and the demo local engine.
TTS_VI_VOICE=vi-VN-Neural2-A
TTS_EN_VOICE=en-US-Neural2-A

# When true, the backend accepts unauthenticated /send requests from the
# Android demo, runs an offline TTS engine, and keeps transcripts in memory.
# NEVER enable in production.
DEMO_MODE=true
